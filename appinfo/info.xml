<?xml version="1.0"?>
<info>
	<id>oo_file_collector</id>
	<name>Сбор файлов ОО</name>
	<summary>Сбор файлов от образовательных организаций</summary>
	<description><![CDATA[
Nextcloud ExApp для создания кампаний сбора файлов, папок организаций,
публичных upload-ссылок, таблиц рассылки, проверки загруженных файлов,
preview/apply массовых операций и журнала действий.
	]]></description>
	<version>1.0.5</version>
	<licence>MIT</licence>
	<author>kyasu-404</author>
	<namespace>MonitoringRequestManager</namespace>
	<category>tools</category>
	<dependencies>
		<nextcloud min-version="30" max-version="35"/>
	</dependencies>
	<external-app>
		<docker-install>
			<registry>ghcr.io</registry>
			<image>kyasu-404/oo_file_collector</image>
			<image-tag>1.0.5</image-tag>
		</docker-install>
		<environment-variables>
			<variable>
				<name>MRM_ROOT_PATH</name>
				<display-name>Root monitoring folder</display-name>
				<description>All file operations are restricted to this Nextcloud path</description>
				<default>/Мониторинги</default>
			</variable>
			<variable>
				<name>MRM_DATABASE_URL</name>
				<display-name>Database URL</display-name>
				<description>SQLAlchemy URL. Defaults to SQLite inside the ExApp persistent volume.</description>
			</variable>
		</environment-variables>
		<routes>
			<route>
				<url>^/$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/api/.*$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/api/.*$</url>
				<verb>POST</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/api/.*$</url>
				<verb>PUT</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/api/.*$</url>
				<verb>DELETE</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/js/.*$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/css/.*$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
			<route>
				<url>^/img/.*$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
			</route>
		</routes>
	</external-app>
</info>
